# Runtime settings for llm-hub. Copy to `.env`, replace the values, keep it out of git
# (`.env` is in .gitignore; this template is safe to commit).
#
# Everything else - ports, trust zones, the public path allowlist, upstreams, timeouts -
# lives in data/config.yaml. Caller API keys are NOT here: they are minted at /admin ->
# API keys and stored as hashes in llmhub.db.

# Which config.yaml to load. The image already exports CONFIG_PATH=/data/config.yaml, so
# this line is only needed for a bare-Python run or a config mounted somewhere else.
# Relative values are resolved from app/, so a repo checkout uses ./data/config.yaml.
# CONFIG_PATH=/data/config.yaml

# Console password at /admin (the user name is always `admin`). It is exchanged for a signed
# 12-hour session cookie and is NOT a request credential - sending it as Bearer/X-API-Key
# answers 401. Required for a new deployment: it is the only way to mint the first caller
# key. Unset = console disabled (every /v1/management/* route returns 503), and with an empty
# api_keys table the gateway refuses to start. Use >= 32 random characters for any
# internet-facing instance; a documented example value refuses to start.
ADMIN_PASSWORD=replace-me-with-a-long-random-password

# Optional. Outbound credential for the System One backend (laya-server, or an Ollama that
# checks it). The name must match `systemone.api_key_env`, whose default is this variable.
# Read by llm-hub, never by callers; leave it out for an unauthenticated backend.
# SYSTEMONE_SERVER_API_KEY=
