# Runtime secrets for llm-hub.
#
# Copy this file to `.env` and fill in your own random keys (>= 16 chars each).
# Multiple keys are separated by commas. Keep `.env` private and out of version control
# (it is listed in .gitignore); this `.env.example` is safe to commit.
#
# The keys are injected into the container as GATEWAY_API_KEYS so that config.json
# never has to contain credentials.
GATEWAY_API_KEYS=sk-gateway-example-key,sk-gateway-example-two

# Disable API key authentication entirely (default: not set).
# Accepts: true | 1 | yes (case-insensitive).
# When enabled, all requests are served without API key validation.
# GATEWAY_AUTH_DISABLED=false

# Upstream provider keys (optional). Each is read from the environment variable named
# in the config, so the secret never lands in config.json:
#   SYSTEMONE_SERVER_API_KEY  - systemone.api_key_env; signs the POST /v1/systemone call
#                               made by the gateway. Required by laya-server only - an
#                               Ollama 0.40+ backend ignores the header, so it can stay
#                               empty when systemone.backend points at Ollama.
#                               (Renamed from LAYA_SERVER_API_KEY.)
#   OPENCODE_GATEWAY_API_KEY  - websearch.api_key_env; signs the web search call made by
#                               POST /v1/tools/web-search. Leave unset when the provider
#                               is reachable without a key (websearch.api_key_env = "").
# SYSTEMONE_SERVER_API_KEY=
# OPENCODE_GATEWAY_API_KEY=
