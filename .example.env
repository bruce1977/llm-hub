# Runtime secrets for llm-hub.
#
# Copy this file to `.env` and fill in your own random keys (>= 16 chars each).
# Multiple keys are separated by commas. Keep `.env` private and out of version control
# (it is listed in .gitignore); this `.example.env` is safe to commit.
#
# The keys are injected into the container as GATEWAY_API_KEYS so that config.json
# never has to contain credentials.
GATEWAY_API_KEYS=sk-gateway-example-key,sk-gateway-example-two

# Disable API key authentication entirely (default: not set).
# Accepts: true | 1 | yes (case-insensitive).
# When enabled, all requests are served without API key validation.
# GATEWAY_AUTH_DISABLED=false
