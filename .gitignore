# Secrets: contains GATEWAY_API_KEYS, must never be committed
.env
.keys
*.secret

# Local config (machine-specific, not committed): keep example.* tracked instead
data/config.json
data/config.yaml
config.json

# Request log database (SQLite + WAL sidecar files)
data/*.db
data/*.db-wal
data/*.db-shm

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
.workbuddy/

# Editors / OS
.idea/
.vscode/
.ruff_cache/
.DS_Store
_*.*

# Frontend toolchain: the built console (app/web) IS committed -- the image copies it
# straight from the app package, so the container never runs node. The installed
# packages and the Vite cache are not.
web/node_modules/
web/.vite/
web/.vite-temp/

# Logs
*.log
