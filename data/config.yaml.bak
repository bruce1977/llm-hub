# Converted from data/config.json (JSON -> YAML).
# 源 JSON 暂时保留。运行时配置：已被 .gitignore 忽略，含本机特定值。
server:
  host: 0.0.0.0
  port: 8000
  log_level: info
  request_timeout: 600.0
  max_concurrency: 64
  upstream_keepalive_expiry: 30.0
auth:
  enabled: true
  allow_anonymous_health: true
  # 匹配这些正则的来源地址（按 TCP 对端，不看 X-Forwarded-For）可以打开 /docs，
  # 并且调用网关 API 时免 API Key 检查。空数组 = 无人豁免。
  # 密钥本身只来自 .env（GATEWAY_API_KEYS / GATEWAY_API_KEYS_FILE → data/.keys）。
  allow_access_ip_whitelist:
  - ^127\.0\.0\.1$
  - ^192\.168\.10\.[0-9]+$
routing:
  strict: false
upstreams:
- name: ollama-gpu
  type: ollama
  base_url: http://127.0.0.1:11434
  models:
  - qwen3.5:9b
  - qwen3.6:35b-pruned
  - qwen3-reranker:4b
  model_aliases:
    qwen3.6:35b: qwen3.6:35b-pruned
  timeout: 600
  priority: 0
  description: Local default Ollama instance (CPU/GPU)
- name: ollama-igpu
  type: ollama
  base_url: http://127.0.0.1:11435
  models:
  - qwen3.5:4b
  - bge-m3:latest
  - tev1:latest
  - nimble:latest
  model_aliases:
    bge-m3: bge-m3:latest 
    nimble: nimble:latest
    tev1: tev1:latest
  timeout: 1800
  priority: 10
  description: 'Second Ollama instance on the integrated GPU (iGPU). Chat/generation only - do NOT route the reranker here: this is the archived IPEX-LLM build (Ollama 0.9.3) which silently ignores ''logprobs'', degrading rerank scores to the 0.9/0.1 text fallback. Use the slim qwen3-reranker:4b-rk variant on port 11434 instead (num_ctx 8192 -> ~4 GB VRAM instead of 9.3 GB).'
# - name: lmstudio
#   type: lmstudio
#   base_url: http://host.docker.internal:11433
#   models:
#   - qwen/qwen3.5-9b
#   - prism-ml/bonsai-27b
#   - meta/muse-glimmer
#   model_aliases:
#     lms/qwen3.6:35b: qwen3.6-35b-a3b-pruned-v2
#     lms/qwen3.5:9b: qwen/qwen3.5-9b
#   timeout: 600
#   priority: 20
#   description: LM Studio (OpenAI-compatible API); verbose model ids exposed under short names via model_aliases
- name: opencode
  type: opencode
  base_url: http://vm.gateway:11430
  models:
  - auto
  - opencode/*
  model_aliases:
    opencode/auto: auto
  timeout: 300
  priority: 30
  description: 'OpenCode API Gateway: free built-in models (OpenAI-compatible chat) plus the web search provider used by POST /v1/tools/web-search'
default_upstream: ollama
# Each entry below is a model of its own: `model` is what actually gets forwarded upstream,
# `params` are force-injected, and the console lists the alias as a separate row (its target
# stays callable under its own name). A pure display rename belongs in `model_aliases`.
aliases:
  qwen3.5:4b-nothink:
    model: qwen3.5:4b
    params:
      think: false
    description: 4B model with thinking disabled for faster responses
num_ctx_overrides:
  qwen3.6:35b-pruned: 65536
  qwen3.5:9b: 16384
# 控制台各 API 测试窗口的可选模型；空列表 = 按推导取（见 config.example.yaml 的说明）。
# 名字可以写真实模型 id，也可以写别名。
api_models:
  generate: []
  embed:
  - bge-m3
  rerank:
  - qwen3-reranker:4b
  systemone:
  - tev1
  - nimble
  websearch: 
  - ""
  - opencode/auto
rerank:
  enabled: true
  endpoint: /v1/rerank
  mode: logprobs
  models:
  - qwen3-reranker:4b
  instruction: Given a web search query, retrieve relevant passages that answer the query. A passage is relevant only if it directly answers the specific question asked. Passages that merely share the same broad topic, mention related keywords, or talk about the same field or entity without answering the question are NOT relevant.
  yes_token: 'yes'
  no_token: 'no'
  yes_aliases: []
  no_aliases: []
  temperature: 0.0
  top_logprobs: 20
  max_tokens: 4
  token_scan_depth: 4
  stop: []
  keep_alive: 3m
  logprobs_fallback: true
  fallback_yes: 0.9
  fallback_no: 0.1
  fallback_unknown: 0.0
  normalize: false
  max_concurrency: 8
  return_documents: true
  model_modes: {}
  upstream_api: auto
  raw_prompt: true
  disable_thinking: true
  max_documents: 0
  max_document_chars: 0
  on_error: score_zero
systemone:
  enabled: true
  backend: http://llm.home:11435
  model: tev1
  api_key_env: SYSTEMONE_SERVER_API_KEY
  path: v1/systemone
  timeout: 60.0
websearch:
  enabled: true
  upstream: opencode
  path: v1/web-search
  api_key_env: ''
  timeout: 300.0
request_log:
  enabled: true
security:
  admin_endpoints: deny
  blocked_paths: []
  cors_origins: []
  max_body_bytes: 33554432
  allow_query_api_key: false
  expose_health_details: false
  fail_on_weak_keys: true
  allowed_client_ips: []
  allowed_http_methods:
  - GET
  - POST
  path_allowlist: []
  rate_limit:
    enabled: false
    per_minute: 60
    burst: 20
    by: ip
