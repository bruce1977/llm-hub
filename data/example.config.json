{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "log_level": "info",
    "request_timeout": 600.0,
    "max_concurrency": 64,
    "upstream_keepalive_expiry": 30.0
  },
  "auth": {
    "enabled": true,
    "api_keys": [],
    "allow_anonymous_health": true
  },
  "routing": {
    "strict": false
  },
  "upstreams": [
    {
      "name": "ollama",
      "type": "ollama",
      "base_url": "http://host.docker.internal:11434",
      "models": [
        "qwen3:4b",
        "qwen3:8b",
        "qwen3.6:35b-pruned",
        "qwen3-reranker:4b-rk"
      ],
      "timeout": 600,
      "priority": 0,
      "description": "Primary Ollama instance (GPU): keep the reranker here. qwen3-reranker:4b-rk is a num_ctx=8192 variant of qwen3-reranker:4b (see Modelfile.reranker) - same scores, ~4 GB VRAM instead of ~9.3 GB."
    },
    {
      "name": "ollama-ipex-llm",
      "type": "ollama",
      "base_url": "http://host.docker.internal:11435",
      "models": [
        "qwen3:4b"
      ],
      "timeout": 1800,
      "priority": 10,
      "description": "Second Ollama instance (iGPU) - lower priority, used as fallback for overlapping models. Do NOT route the reranker here if this is the archived IPEX-LLM build (Ollama 0.9.3): it silently ignores 'logprobs'."
    },
    {
      "name": "lmstudio",
      "type": "lmstudio",
      "base_url": "http://host.docker.internal:1234",
      "models": [],
      "model_aliases": {
        "qwen3.5:9b": "qwen/qwen3.5-9b"
      },
      "timeout": 600,
      "priority": 20,
      "description": "LM Studio (OpenAI-compatible API); verbose model ids exposed under short names via model_aliases"
    }
  ],
  "default_upstream": "ollama",
  "aliases": {
    "qwen3:4b-nothink": {
      "model": "qwen3:4b",
      "params": { "think": false },
      "description": "4B model with thinking disabled for faster responses"
    },
    "qwen3.6:35b-nothink": {
      "model": "qwen3.6:35b-pruned",
      "upstream": "ollama",
      "params": { "think": false },
      "description": "35B pruned model with thinking disabled"
    }
  },
  "rerank": {
    "enabled": true,
    "endpoint": "/v1/rerank",
    "mode": "logprobs",
    "models": ["qwen3-reranker:4b-rk", "qwen3-reranker:4b"],
    "instruction": "Given a web search query, retrieve relevant passages that answer the query. A passage is relevant only if it directly answers the specific question asked. Passages that merely share the same broad topic, mention related keywords, or talk about the same field or entity without answering the question are NOT relevant.",
    "yes_token": "yes",
    "no_token": "no",
    "yes_aliases": [],
    "no_aliases": [],
    "temperature": 0.0,
    "top_logprobs": 20,
    "max_tokens": 4,
    "token_scan_depth": 4,
    "stop": [],
    "options": { "num_ctx": 8192 },
    "keep_alive": "3m",
    "logprobs_fallback": true,
    "fallback_yes": 0.9,
    "fallback_no": 0.1,
    "fallback_unknown": 0.0,
    "normalize": false,
    "max_concurrency": 8,
    "return_documents": true,
    "model_modes": {},
    "upstream_api": "auto",
    "raw_prompt": true,
    "disable_thinking": true,
    "max_documents": 0,
    "max_document_chars": 0,
    "on_error": "score_zero"
  },
  "security": {
    "admin_endpoints": "deny",
    "blocked_paths": [],
    "allow_docs": false,
    "cors_origins": [],
    "max_body_bytes": 33554432,
    "allow_query_api_key": false,
    "expose_health_details": false,
    "fail_on_weak_keys": true,
    "allowed_client_ips": [],
    "allowed_http_methods": ["GET", "POST"],
    "path_allowlist": [],
    "rate_limit": {
      "enabled": false,
      "per_minute": 60,
      "burst": 20,
      "by": "ip"
    }
  }
}
